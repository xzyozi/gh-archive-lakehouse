# Airflow Environment Variables Template
# Copy this file to .env and adjust variables as needed

# Airflow UID (on macOS/Linux, run `id -u` to find your UID, default is 50000)
AIRFLOW_UID=50000

# Google Cloud Project & Storage Settings
GCP_PROJECT_ID=your-gcp-project-id
# Terraform の output "gcs_bucket_name" で出力されたバケット名（デフォルト: <project_id>-octopulse-lakehouse）
GCS_BUCKET_NAME=your-gcp-project-id-octopulse-lakehouse
# Terraform の dataset_prefix と一致させる（<prefix>_bronze / _silver / _gold）。DAG と dbt の両方が参照する
GCP_DATASET_PREFIX=octopulse
# dbt の接続先 target（dbt/profiles.yml.example の dev / prod）
DBT_TARGET=dev

# Airflow web UI admin account (required; no default password is provided)
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change-me

# Host directory holding gcloud ADC (read-only mount). Default: ~/.config/gcloud
# Windows example: GCLOUD_CONFIG_DIR=C:/Users/<user>/AppData/Roaming/gcloud
# GCLOUD_CONFIG_DIR=

# Google Application Credentials (mounted from host)
GOOGLE_APPLICATION_CREDENTIALS=/home/airflow/.config/gcloud/application_default_credentials.json

# Optional: GitHub Personal Access Token (for Enrichment task)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
