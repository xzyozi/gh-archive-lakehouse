# Airflow Environment Variables Template
# Copy this file to .env and adjust variables as needed

# Airflow UID (on macOS/Linux, run `id -u` to find your UID, default is 50000)
AIRFLOW_UID=50000

# Google Cloud Project & Storage Settings
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-octopulse-bucket-name

# Google Application Credentials (mounted from host)
GOOGLE_APPLICATION_CREDENTIALS=/home/airflow/.config/gcloud/application_default_credentials.json

# Optional: GitHub Personal Access Token (for Enrichment task)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
